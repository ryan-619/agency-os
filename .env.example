# ---------------------------------------------------------------------------
# Agency OS — copy to .env and fill in. NEVER commit the filled-in file.
#
# PROMPT.md §2.3: no credential is ever written to a source file, a log line,
# or an agent's context window. Values here are read at point of use only.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Inside docker compose the host is the service name `db`.
#
# A REMOTE database MUST carry ?sslmode=require (or verify-full). Without it
# node-postgres sends a PLAINTEXT startup packet carrying the username and
# database, and still connects — nothing would tell you. apps/web refuses to
# boot on a non-loopback host with no sslmode, for that reason. Loopback and
# the compose service name are exempt: there is no public network there.
#
#   managed    postgres://user:pw@ep-xxx.region.aws.neon.tech/db?sslmode=require
DATABASE_URL=postgres://agency:agency@db:5432/agency
# When running the app on the host against the compose Postgres, use:
# DATABASE_URL=postgres://agency:agency@localhost:5432/agency
# Connection pool ceiling for the web app. Lower it if Postgres is shared.
DATABASE_POOL_MAX=10
POSTGRES_USER=agency
POSTGRES_PASSWORD=agency
POSTGRES_DB=agency

# --- Auth.js --------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Public origin of the web app. REQUIRED — Auth.js reads this variable itself
# when it builds magic-link URLs, and with it unset it falls back to the
# request's Host / X-Forwarded-Host header, letting a forged header decide
# where the sign-in link points.
AUTH_URL=http://localhost:3000
# Set to true only when running behind a proxy you control (compose, the VPS).
# Leave UNSET rather than setting it to false — Auth.js applies its own
# default only when the variable is absent.
AUTH_TRUST_HOST=true

# --- Outbound mail (magic links in Phase 0; campaign mail from Phase 4) ----
# In local development these point at the Mailpit container, which accepts
# everything and shows it at http://localhost:8025. Mailpit is a DEV-ONLY
# service: it never relays. See docker-compose.yml.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="Agency OS <agency-os@localhost>"

# --- Seed -----------------------------------------------------------------
# The single organisation and its owner, created by `npm run db:seed`.
SEED_ORG_NAME=Agency
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_NAME=Owner

# --- Secrets at rest (§2.3) -----------------------------------------------
# Encrypts third-party credentials (connector tokens, and from Phase 4 the
# mail and Twilio keys) before they touch the database. Generate with:
#   openssl rand -base64 32
# Losing this makes every stored credential unreadable — they are not
# recoverable from a backup of Postgres alone, which is the point. Rotating it
# means re-entering them; the key_version column exists so that failure names
# itself instead of returning garbage.
SECRETS_KEY=

# --- Agent worker ---------------------------------------------------------
# The Agent SDK authenticates with an API key from the environment (§5).
# Subscription login is not available to third-party products.
ANTHROPIC_API_KEY=
AGENT_PORT=3001

# Proves a caller of the worker's internal API is the web app. REQUIRED: the
# worker refuses to boot without it, and the web app reports chat as
# unconfigured. Both processes need the SAME value. At least 32 characters:
#   openssl rand -base64 32
AGENT_INTERNAL_TOKEN=

# Where the web app finds the worker's internal API. Note the port: the worker
# serves health on AGENT_PORT and the API on AGENT_PORT + 1.
#   local        http://127.0.0.1:3002
#   compose      http://agent:3002
AGENT_URL=http://127.0.0.1:3002

# What that API binds to. Loopback is right when the worker and the web app
# share a host. Under compose they do NOT — each service has its own network
# namespace — so compose sets 0.0.0.0 and does not publish the port.
AGENT_BIND=127.0.0.1

# §5.4 bounds ONE turn; AGENT_SESSION_BUDGET_USD bounds a conversation, which
# nothing in the SDK does. AGENT_TURN_TIMEOUT_MINUTES must EXCEED
# APPROVAL_TTL_MINUTES or the worker refuses to boot: a turn killed while its
# own approval is still live means a human's decision lands on a turn that no
# longer exists to consume it.
AGENT_MAX_TURNS=30
AGENT_MAX_BUDGET_USD=2
AGENT_SESSION_BUDGET_USD=20

# Which model answers a chat turn. Unset uses the SDK's own default, which is
# NOT the cheap one.
#
# Measured on this product, against the real database: one heavy agentic turn
# — 22 tool calls, 284 events, seventeen companies scanned and scored — cost
# $0.124 at the SDK default. Haiku 4.5 is $1/$5 per MTok against Opus-tier's
# $5/$25, so the same turn lands near $0.02, and "score the pipeline, draft an
# opener" is well inside what it does well. Reach for a larger model when the
# output is actually disappointing, not before.
AGENT_MODEL=claude-haiku-4-5
APPROVAL_TTL_MINUTES=30
AGENT_TURN_TIMEOUT_MINUTES=35

# §6's skills volume. Unset means no skills, which is the default.
#
# Skills are filesystem-only in the SDK, and they are discovered ONLY when the
# project setting source is loaded — measured, not assumed. That source is one
# of the three documented ways the approval gate is skipped, because a settings
# file in it can allow tool calls the gate never sees. So the worker refuses to
# load skills from a directory containing .claude/settings.json, agents/,
# commands/, hooks/ or mcp.json, and names the file that stopped it.
#
# Point this at a directory that holds ONLY .claude/skills/<name>/SKILL.md.
AGENT_SKILLS_DIR=

# --- Outreach (Phase 4, §8.4) --------------------------------------------
# The worker sends through SMTP_* / MAIL_FROM above — the same mailbox the web
# app uses for magic links, or better, a warmed outreach mailbox. All of this
# is OPTIONAL: a worker with no mailbox runs chat and scanning and sends
# nothing, which is a complete configuration and the one CI runs. /readyz
# reports `outreach: disabled | send-only | send-and-receive` so nobody
# wonders why a campaign is not moving.
#
# Replies are detected over IMAP IDLE on the mailbox below (§8.4). The worker
# marks what it has handled as read, so it must OWN this mailbox: a person
# reading the same inbox in a mail client marks messages read too, and a reply
# they open first is one the worker never sees.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SECURE=true
IMAP_MAILBOX=INBOX
# How often the sender looks for approved and queued messages, and how many it
# dispatches per pass across every campaign. The per-campaign daily cap is
# enforced inside the send path; this batch is about fairness, not volume.
OUTREACH_TICK_MS=15000
OUTREACH_BATCH=20

# Bound the blast radius of a subagent fan-out (§7).
CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS=3
CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH=2

# --- Runtime --------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Voice and SMS (Phase 6, §8.5) ----------------------------------------
# The voice service is INBOUND ONLY and starts only behind its compose
# profile: `docker compose --profile voice up -d voice`. §12 says not to
# switch it on before A2P 10DLC registration has cleared.
#
# VOICE_PUBLIC_URL is the origin TWILIO reaches this service at, e.g.
# https://voice.example.com. Every webhook signature is computed over the
# URL Twilio used, which behind a proxy is not the one the socket saw — and
# with this unset the service REFUSES every webhook, because these endpoints
# can write a suppression row.
VOICE_PUBLIC_URL=
VOICE_PORT=3003
VOICE_BIND=127.0.0.1

# Without the auth token no request can be verified, so all of them are
# refused. Fails closed, like INBOUND_WEBHOOK_SECRET above.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Where a warm handoff goes (§8.5). TaskRouter if you have a workspace,
# otherwise a person's number. With neither, the AI says nobody is
# available and hangs up rather than pretending to transfer.
TASKROUTER_WORKFLOW_SID=
VOICE_HANDOFF_NUMBER=

# One org is seeded (§12); set this only if there is ever more than one,
# because the service refuses to guess whose call it is.
VOICE_ORG_ID=

VOICE_LANGUAGE=en-US
VOICE_TTS_PROVIDER=
VOICE_TTS_VOICE=
VOICE_MAX_CALL_SECONDS=900

# --- Single-shot models (§5.5) --------------------------------------------
# The seam for non-agentic calls: summarising a transcript, classifying a
# reply, polishing copy. Unset means the deterministic answer, which every
# one of those jobs already has and which is never worse than nothing.
#
# `ollama` keeps the prompt on the agency's own hardware, which §5.5 says is
# the point. The remote providers additionally need
# LLM_ALLOW_REMOTE_LEAD_DATA, because a transcript or a reply is a named
# person's words and sending it offsite is a disclosure somebody has to
# choose. Nothing here is required for the product to work.
LLM_PROVIDER=
LLM_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Declared, never inferred from the URL: an Ollama on a rented box is not
# the agency's hardware. Set to false when the endpoint is somebody else's.
OLLAMA_IS_LOCAL=true
OPENAI_API_KEY=
LLM_ALLOW_REMOTE_LEAD_DATA=false

# --- Authenticating the agent worker without an API key (§13) ------------
# The Agent SDK does not require one: a machine logged into Claude Code can
# run real turns, which is how Phase 2 and 3's Definitions of Done are proved
# without buying credit. DEVELOPMENT ONLY — loadEnv refuses this outright when
# NODE_ENV=production, because it authenticates as a PERSON whose credential
# cannot be billed, audited or revoked separately from them (§2.3).
#
#   claude auth login      # for the binary below, NOT the desktop app's login
#   AGENT_USE_LOCAL_LOGIN=true npx tsx --env-file=.env apps/agent/src/index.ts
#
# It deliberately WINS over an ANTHROPIC_API_KEY left in this file, so a stale
# key cannot quietly answer an explicit request for your own login.
AGENT_USE_LOCAL_LOGIN=false
# The SDK drives a CLI and looks for `claude` on PATH. Set this when the only
# copy came with the desktop app.
CLAUDE_CODE_PATH=
