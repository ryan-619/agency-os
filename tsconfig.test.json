{
  "$schema": "https://json.schemastore.org/tsconfig",
  // Typechecks the test suite, which the per-package build configs exclude
  // (they emit dist/, and tests are not shipped). Without this, `tsc --build`
  // covered zero test code — in a repo where the tests are the stated proof of
  // the §2 invariants. Run by `npm run typecheck`.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"],
    // Relaxed for tests ONLY; src keeps it on. A test that indexes rows[0] and
    // gets undefined SHOULD blow up loudly — that is the assertion failing.
    // Requiring a guard on every row access would bury the real type errors
    // this config exists to catch.
    "noUncheckedIndexedAccess": false
  },
  // Every glob vitest runs, plus the sources they import, plus the CLIs under
  // tools/. vitest's include is ['packages/*/test/**', 'apps/*/test/**'] — a
  // test placed in apps/agent/test WILL run, so it has to be typechecked too
  // or it becomes the only untyped code in a repo whose stated standard is
  // that the test suite belongs inside the type system. tools/*.ts was checked
  // by nothing at all until now.
  //
  // apps/web/test is the one exception, and it is excluded rather than
  // dropped: `apps/web` has no `"type": "module"` (Next does not need one) and
  // resolves as Bundler, so under this config's nodenext every file in that
  // tree is a CommonJS file and every `import` in it is an error. It is
  // typechecked by apps/web/tsconfig.json instead, which `npm run typecheck`
  // also runs. The invariant is therefore "every glob vitest runs is
  // typechecked by SOME config in `npm run typecheck`", not "by this one".
  "exclude": ["apps/web/test/**"],
  "include": [
    "packages/*/test/**/*.ts",
    "packages/*/src/**/*.ts",
    "apps/*/test/**/*.ts",
    "apps/agent/src/**/*.ts",
    "packages/scanner/src/**/*.ts",
    "tools/**/*.ts",
    "vitest.config.ts"
  ]
}
