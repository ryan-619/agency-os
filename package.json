{
  "name": "agency-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build && tsc -p tsconfig.test.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "npm run db:migrate -w @agency/db --",
    "db:seed": "npm run db:seed -w @agency/db --",
    "dev": "npm run dev --workspace @agency/web",
    "fixtures:capture": "tsx tools/capture-fixtures.ts",
    "fixtures:golden": "python3 tools/python-golden.py",
    "fixtures:html-parity": "python3 tools/html-parity-corpus.py",
    "tables:python": "python3 tools/generate-python-tables.py",
    "scan": "tsx --env-file-if-exists=.env tools/scan.ts",
    "smoke:agent": "tsx --env-file-if-exists=.env tools/smoke-agent.ts",
    "db:local": "tsx tools/local-db.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/mailparser": "^3.4.6",
    "@types/node": "22.18.1",
    "smtp-server": "^3.13.6",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
