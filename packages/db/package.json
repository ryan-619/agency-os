{
  "name": "@agency/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./migrations": "./migrations/",
    "./seed": "./seed/",
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "default": "./dist/repository.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "seed"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed-cli.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "8.16.3",
    "@agency/core": "*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/pg": "8.15.5",
    "tsx": "4.20.6"
  }
}
